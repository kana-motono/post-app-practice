{
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail test:*)",
      "Bash(sail test:*)",
      "Bash(./vendor/bin/sail artisan test:*)",
      "Bash(sail artisan test:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -x vendor/bin/sail || exit 0; ./vendor/bin/sail artisan test >&2 || exit 2",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
